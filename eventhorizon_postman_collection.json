{
  "info": {
    "name": "EventHorizon API Framework",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication Gateway",
      "item": [
        {
          "name": "Register Account",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fredrick Abodunrin\",\n  \"email\": \"dev@example.com\",\n  \"password\": \"SecurePassword123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/register",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Verify Token Link",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/auth/verify-email?token=TOKEN_VALUE",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "auth",
                "verify-email"
              ],
              "query": [
                {
                  "key": "token",
                  "value": "TOKEN_VALUE"
                }
              ]
            }
          }
        },
        {
          "name": "Login Session",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dev@example.com\",\n  \"password\": \"SecurePassword123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/login",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Secured Ecosystem Profiles",
      "item": [
        {
          "name": "View Protected Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{JWT_TOKEN}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/user/profile",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "user",
                "profile"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:5000"
    },
    {
      "key": "JWT_TOKEN",
      "value": ""
    }
  ]
}